@model {{ meta.root_namespace }}.Areas.Admin.Controllers.CharacteristicsViewModel
@{
    ViewData["Title"] = "Характеристики";
}

<h1>Характеристики</h1>
<p class="text-muted">Обобщени спомагателни данни - само за преглед.</p>

{{~ lookup_models = [] ~}}
{{~ for m in spec.models; if m.is_lookup; lookup_models = lookup_models | array.add m; end; end ~}}

<ul class="nav nav-tabs mb-3" role="tablist">
{{~ for m in lookup_models ~}}
{{~ if m.display_name; tab_label = m.display_name; else; tab_label = m.name; end ~}}
    <li class="nav-item" role="presentation">
        <button class="nav-link{{ if for.first }} active{{ end }}" data-bs-toggle="tab" data-bs-target="#tab-{{ m.name | string.downcase }}" type="button">{{ tab_label }}</button>
    </li>
{{~ end ~}}
</ul>

<div class="tab-content">
{{~ for m in lookup_models ~}}
{{~
cols = []
for p in m.properties; if !p.key && !p.foreign_key && !p.computed; cols = cols | array.add p; end; end
~}}
    <div class="tab-pane fade{{ if for.first }} show active{{ end }}" id="tab-{{ m.name | string.downcase }}" role="tabpanel">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>ИД</th>
{{~ for p in cols ~}}
{{~ if p.display_name; col_label = p.display_name; else; col_label = p.name; end ~}}
                    <th>{{ col_label }}</th>
{{~ end ~}}
{{~ for rel in m.relations; if rel.kind == "manyToOne" ~}}
                    <th>{{ rel.navigation }}</th>
{{~ end; end ~}}
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.{{ m.name }}s)
                {
                    <tr>
                        <td>@item.{{ m.properties[0].name }}</td>
{{~ for p in cols ~}}
                        <td>@item.{{ p.name }}</td>
{{~ end ~}}
{{~ for rel in m.relations; if rel.kind == "manyToOne" ~}}
{{~
target_display = "Id"
for tm in spec.models
  if tm.name == rel.target
    for tp in tm.properties; if !tp.key && tp.type == "string" && target_display == "Id"; target_display = tp.name; end; end
  end
end
~}}
                        <td>@item.{{ rel.navigation }}?.{{ target_display }}</td>
{{~ end; end ~}}
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.{{ m.name }}s.Any())
        {
            <p class="text-muted">Няма записи.</p>
        }
    </div>
{{~ end ~}}
</div>
