@* Партиал за качване на изображение - включва се във формите Create/Edit. *@
<div class="mb-3">
    <label class="form-label" for="imageFile">Изображение</label>
    <input class="form-control" id="imageFile" name="imageFile" type="file" accept="image/*" />
    <div class="form-text">Поддържани формати: JPG, PNG. Максимум 5 MB.</div>
</div>
