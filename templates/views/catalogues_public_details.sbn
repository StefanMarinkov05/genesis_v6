@model {{ meta.root_namespace }}.Models.Catalogue
@{
    ViewData["Title"] = Model.Name;
}
{{~
display = "Id"
for tm in spec.models
  if tm.name == primary
    for tp in tm.properties; if !tp.key && tp.type == "string" && display == "Id"; display = tp.name; end; end
  end
end
~}}

<h1>@Model.Name</h1>
<p><span class="badge bg-success">Публичен каталог</span></p>

<ul class="list-group mb-3">
    @if (!Model.Items.Any())
    {
        <li class="list-group-item text-muted">Празен каталог</li>
    }
    @foreach (var item in Model.Items.OrderBy(i => i.Position).ThenBy(i => i.Id))
    {
        <li class="list-group-item">@item.{{ primary }}?.{{ display }}</li>
    }
</ul>

<a class="btn btn-secondary" asp-action="Public">Към публичните каталози</a>
