using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using {{ meta.root_namespace }}.Models;
using {{ meta.root_namespace }}.Services;

{{ ns_open (meta.root_namespace + ".Areas.Client.Controllers") }}

/// <summary>
/// A9 / Задача 26: публична страница на потребител - само за четене, достъпна без вход.
/// Показва снимка/име + обобщеното публично съдържание (обяви, публикации, отзиви,
/// последователи/следвани, публични каталози) чрез споделения UserProfileService.
/// </summary>
[Area("Client")]
[AllowAnonymous]
public class ProfilesController : Controller
{
    private readonly UserProfileService _profiles;

    public ProfilesController(UserProfileService profiles) => _profiles = profiles;

    public async Task<IActionResult> Public(string id)
    {
        if (string.IsNullOrEmpty(id)) return NotFound();
        // publicOnly: true - външните посетители виждат само публичните каталози.
        var vm = await _profiles.BuildAsync(id, publicOnly: true);
        if (vm is null) return NotFound();
        return View(vm);
    }
}
{{ ns_close }}
