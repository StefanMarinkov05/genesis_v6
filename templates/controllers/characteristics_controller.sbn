using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using {{ meta.root_namespace }}.Models;

{{ ns_open (meta.root_namespace + ".Areas.Admin.Controllers") }}

{{~ lookup_models = [] ~}}
{{~ for m in spec.models; if m.is_lookup; lookup_models = lookup_models | array.add m; end; end ~}}
/// <summary>
/// Обединена страница за малките спомагателни модели (Задача 6/7) - вместо всеки да
/// заема собствен ред в администраторското меню, тук се показват само за четене,
/// секционирани по модел.
/// </summary>
[Area("Admin")]
[Authorize(Roles = "{{ subst spec.identity.roles[0].name }}")]
public class CharacteristicsController : Controller
{
    private readonly {{ meta.project_name }}Context _context;

    public CharacteristicsController({{ meta.project_name }}Context context) => _context = context;

    public async Task<IActionResult> Index()
    {
        var vm = new CharacteristicsViewModel
        {
{{~ for m in lookup_models ~}}
            {{ m.name }}s = await _context.{{ m.name }}s.AsNoTracking()
{{~ for rel in m.relations; if rel.kind == "manyToOne" ~}}
                .Include(x => x.{{ rel.navigation }})
{{~ end; end ~}}
                .ToListAsync(),
{{~ end ~}}
        };
        return View(vm);
    }
}

public sealed class CharacteristicsViewModel
{
{{~ for m in lookup_models ~}}
    public List<{{ m.name }}> {{ m.name }}s { get; set; } = new();
{{~ end ~}}
}
{{ ns_close }}
